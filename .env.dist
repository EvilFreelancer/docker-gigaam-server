# Card index: nvidia-smi order for NVIDIA, Level Zero (PCI) order for Intel
GPU_INDEX=0

# Published port
GIGAAM_PORT=8770

# Image tag on Docker Hub (evilfreelancer/gigaam-server:<tag>-cuda / -xpu)
GIGAAM_IMAGE_TAG=latest

# Checkpoints to load, comma separated; each is served as gigaam-<name with dashes>.
# v3_e2e_rnnt is end-to-end: punctuation and text normalization included. Alternatives:
# v3_rnnt, v3_ctc, v3_e2e_ctc, multilingual_ctc, multilingual_large_ctc.
GIGAAM_MODELS=v3_e2e_rnnt

# fp16 encoder (1 = on)
GIGAAM_FP16=1

# Language reported in verbose_json responses
GIGAAM_LANGUAGE=ru

# Long-form chunking: audio longer than 25 s is cut by silero-vad into chunks of up to
# GIGAAM_MAX_CHUNK_S seconds and decoded in batches of GIGAAM_BATCH_SIZE
GIGAAM_BATCH_SIZE=8
GIGAAM_MAX_CHUNK_S=22
GIGAAM_VAD_MAX_GAP_S=0.6

# Upload limit in MB
GIGAAM_MAX_FILE_MB=1024

# Bearer token; empty means no auth
GIGAAM_API_KEY=
